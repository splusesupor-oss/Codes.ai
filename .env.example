# نمونه‌ی متغیرهای محیطی — این فایل فقط شامل «نام» متغیرهاست.
# هرگز فایل .env واقعی (شماره، کد، رمز 2FA، توکن) را commit نکنید.
#
# نام‌ها را کپی کنید در یک فایل .env یا مستقیماً export کنید:

# محل نگهداری سشن و دیتابیس (پیش‌فرض: ./data)
ACOD_DATA_DIR=./data

# لاگین غیرتعاملی (اختیاری). اگر خالی باشند، ربات تعاملی می‌پرسد.
# ACOD_PHONE=
# ACOD_PASSWORD=

# مسیر فایل سشن و دیتابیس مالک (اختیاری)
# ACOD_SESSION=./data/acod_userbot
# ACOD_DB=./data/owner.sqlite3

# دستورها و رفتار
ACOD_OWNER_COMMAND=ai cod
ACOD_KODREZ_COMMAND=کدرز
ACOD_GROUPS_ONLY=1
# هر پیام خصوصی ورودی → ارسال خودکار پیام معرفی (برای خاموش‌کردن: 0)
ACOD_PRIVATE_AUTO_REPLY=1
# دستورهای مدیریت کاربران PV (فقط مالک سراسری، فقط در PV)
ACOD_PV_COUNT_COMMAND=تعداد اعضا
ACOD_PV_LIST_COMMAND=لیست اعضا
ACOD_PV_UNKNOWN_NAME=کاربر بدون نام
ACOD_MAX_MESSAGE_CHARS=3500
ACOD_LINK_PREVIEW=0

# حالت نقل‌قول: entity | reply | off
ACOD_QUOTE_MODE=entity
