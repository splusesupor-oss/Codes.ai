# نمونه‌ی متغیرهای محیطی — این فایل فقط شامل «نام» متغیرهاست.
# هرگز فایل .env واقعی (شماره، کد، رمز 2FA، توکن) را commit نکنید.
#
# نام‌ها را کپی کنید در یک فایل .env یا مستقیماً export کنید:

# محل نگهداری سشن و دیتابیس (پیش‌فرض: ./data)
ACOD_DATA_DIR=./data

# لاگین غیرتعاملی (اختیاری). اگر خالی باشند، ربات تعاملی می‌پرسد.
# ACOD_PHONE=
# ACOD_PASSWORD=

# مسیر فایل سشن و دیتابیس مالک (اختیاری)
# ACOD_SESSION=./data/acod_userbot
# ACOD_DB=./data/owner.sqlite3

# دستورها و رفتار
ACOD_OWNER_COMMAND=ai cod
# املاهای پذیرفته‌شده‌ی همان دستور (با کاما جدا شوند) — «ai code» هم دستور مالک است
ACOD_OWNER_ALIASES=ai cod,ai code
# هر بار مالک دستور را در یک گروه بفرستد، همان متن معرفی (پیام اولیه) ارسال شود
ACOD_ANNOUNCE_ON_OWNER_REPEAT=1
ACOD_KODREZ_COMMAND=کدرز
ACOD_GROUPS_ONLY=1
# هر پیام خصوصی ورودی → ارسال خودکار پیام معرفی (برای خاموش‌کردن: 0)
ACOD_PRIVATE_AUTO_REPLY=1
# دستورهای مدیریت کاربران PV (فقط مالک سراسری، فقط در PV)
ACOD_PV_COUNT_COMMAND=تعداد اعضا
ACOD_PV_LIST_COMMAND=لیست اعضا
ACOD_PV_UNKNOWN_NAME=کاربر بدون نام
ACOD_MAX_MESSAGE_CHARS=3500
ACOD_LINK_PREVIEW=0

# حالت نقل‌قول: entity | reply | off
ACOD_QUOTE_MODE=entity

# ---------------------------------------------------------------------------
# هوش مصنوعی گروه‌ها (Cloudflare Workers AI) — فقط GROUP، بی‌ارتباط با PV
# ---------------------------------------------------------------------------
# این دو مقدار را از داشبورد Cloudflare (Workers AI) بردارید و در «.env واقعی»
# بنویسید؛ همین‌جا عمداً «خالی» گذاشته شده‌اند و هرگز مقدار واقعی (Account ID/Token)
# را داخل این فایل یا هر جای مخزن commit نکنید.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# مدل (پیش‌فرض: @cf/zai-org/glm-4.7-flash)
ACOD_AI_MODEL=@cf/zai-org/glm-4.7-flash

# سهمیه‌ی داخلی روزانه به تفکیک هر گروه (بر اساس روز UTC)
# هر گروه مستقل از بقیه تا این تعداد درخواست در روز مجاز است.
ACOD_AI_DAILY_QUOTA=5000
# سقف توکن خروجی مدل برای هر پاسخ
ACOD_AI_MAX_OUTPUT_TOKENS=256
# حداکثر طول متن ورودی هر پیام کاربر (مازاد بریده می‌شود)
ACOD_AI_MAX_INPUT_CHARS=800
# تعداد جفت گفت‌وگوهایی که به مدل فرستاده می‌شود (۰ = بدون تاریخچه)
ACOD_AI_HISTORY_PAIRS=2
# مهلت پاسخ مدل (ثانیه)
ACOD_AI_TIMEOUT=45
# مالک سراسری خودکار مجاز باشد؟ (1/0)
ACOD_AI_OWNER_ALLOWED=1
