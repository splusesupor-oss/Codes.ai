# نمونه‌ی متغیرهای محیطی — این فایل فقط شامل «نام» متغیرهاست.
# ⚠️ هشدار امنیتی: هرگز فایل .env واقعی (شماره، کد، رمز 2FA، توکن‌های API) را commit نکنید!
#
# نام‌ها را کپی کنید در یک فایل .env یا مستقیماً export کنید:

# محل نگهداری سشن و دیتابیس (پیش‌فرض: ./data)
ACOD_DATA_DIR=./data

# لاگین غیرتعاملی (اختیاری). اگر خالی باشند، ربات تعاملی می‌پرسد.
# ACOD_PHONE=
# ACOD_PASSWORD=

# مسیر فایل سشن و دیتابیس مالک (اختیاری)
# ACOD_SESSION=./data/acod_userbot
# ACOD_DB=./data/owner.sqlite3

# دستورها و رفتار
ACOD_OWNER_COMMAND=ai cod
ACOD_OWNER_ALIASES=ai cod,ai code
ACOD_ANNOUNCE_ON_OWNER_REPEAT=1
ACOD_KODREZ_COMMAND=کدرز
ACOD_GROUPS_ONLY=1
ACOD_PRIVATE_AUTO_REPLY=1
ACOD_PV_COUNT_COMMAND=تعداد اعضا
ACOD_PV_LIST_COMMAND=لیست اعضا
ACOD_PV_UNKNOWN_NAME=کاربر بدون نام
ACOD_MAX_MESSAGE_CHARS=3500
ACOD_LINK_PREVIEW=0
ACOD_QUOTE_MODE=entity

# ---------------------------------------------------------------------------
# هوش مصنوعی گروه‌ها (Cloudflare Workers AI) — پشتیبانی از چند حساب + چرخش خودکار
# ---------------------------------------------------------------------------
# ترتیب اولویت خواندن حساب‌ها در Config.cloudflare_accounts:
#   ۱) اگر CLOUDFLARE_ACCOUNTS_JSON مقدار معتبر داشت -> parse می‌شود
#   ۲) وگرنه CF_ACCOUNT_1_ID/TOKEN تا CF_ACCOUNT_N_ID/TOKEN به ترتیب شماره جمع می‌شود
#   ۳) وگرنه CLOUDFLARE_ACCOUNT_ID + CLOUDFLARE_API_TOKEN قدیمی به‌عنوان یک حساب برمی‌گردد
#
# نکته مهم: توکن‌های ساخته‌شده داخل «یک» حساب Cloudflare سهمیه‌ی مشترک ۱۰٬۰۰۰ نورون دارند؛
# برای افزایش واقعی ظرفیت روزانه باید حساب‌های Cloudflare جداگانه بسازید.

# روش ۱ (آرایه JSON یک‌خطی):
# CLOUDFLARE_ACCOUNTS_JSON=[{"account_id":"...","api_token":"..."},{"account_id":"...","api_token":"..."}]

# روش ۲ (متغیرهای شماره‌گذاری‌شده — ساده و خوانا در .env):
CF_ACCOUNT_1_ID=
CF_ACCOUNT_1_TOKEN=
CF_ACCOUNT_2_ID=
CF_ACCOUNT_2_TOKEN=
# CF_ACCOUNT_3_ID=
# CF_ACCOUNT_3_TOKEN=

# روش ۳ (سازگاری عقب‌رو با تک‌حساب قدیمی):
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# مدل پیش‌فرض Cloudflare Workers AI
ACOD_AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast

# سهمیه‌ی داخلی روزانه به تفکیک هر گروه (بر اساس Asia/Tehran)
ACOD_AI_DAILY_QUOTA=5000
ACOD_AI_MAX_OUTPUT_TOKENS=1024
ACOD_AI_MAX_INPUT_CHARS=800
ACOD_AI_HISTORY_PAIRS=2
ACOD_AI_TIMEOUT=45
ACOD_AI_OWNER_ALLOWED=1

# اتصال خودکار مدل Cloudflare به دانش زنده و جستجوی وب تا سال ۲۰۲۶ میلادی / ۱۴۰۵ خورشیدی (۱ = فعال پیش‌فرض)
ACOD_AI_WEB_SEARCH=1

# --- کلید Groq برای مدل ۱ (چت)، مدل ۳ (کدنویسی) و فال‌بک خودکار هنگام خطای Cloudflare ---
GROQ_API_KEY=
